<div class="ru-auth">
  <header class="ru-header">
    <span class="ru-header__logo" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.2"/>
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.2"/>
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.2"/>
        <path d="M14 14h2.5v2.5H14zM18 18h2.5M18 14h2.5M14 20.5V18"/>
      </svg>
    </span>

    <div class="ru-header__text">
      <div class="ru-header__row">
        <span class="ru-header__title">RU UnB</span>
        <span class="ru-badge">OPERACIONAL</span>
      </div>
      <span class="ru-header__subtitle">Campus Darcy Ribeiro · Piso 2</span>
    </div>
  </header>

  <main class="ru-main">
    <section class="ru-card" aria-labelledby="ru-auth-title">
      <svg class="ru-card__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="15" rx="2.5"/>
        <path d="M9 5V3.5h6V5"/>
        <circle cx="9" cy="12" r="1.8"/>
        <path d="M6 17c.4-1.6 1.6-2.4 3-2.4s2.6.8 3 2.4M14.5 11.5H18M14.5 15H18"/>
      </svg>

      <h1 id="ru-auth-title" class="ru-card__title">Autenticação do Operador</h1>
      <p class="ru-card__lead">
        Informe suas credenciais funcionais para iniciar a sessão segura e liberar o terminal de catraca.
      </p>

      <% if flash[:alert] %>                                                                 
        <div class="ru-alert ru-alert--error" role="alert"><%= flash[:alert] %></div>         
      <% elsif flash[:notice] %>                                                              
        <div class="ru-alert ru-alert--success" role="status"><%= flash[:notice] %></div>     
      <% end %>                                                                               

      <%= form_with url: autenticacao_operador_path, class: "ru-form", html: { novalidate: true } do %>   
        <div class="ru-field">
          <div class="ru-field__head">
            <label class="ru-field__label" for="operador_identificacao">Matrícula SIAPE ou Usuário SIGAA / gov.br</label>
            <span class="ru-field__hint">Obrigatório</span>
          </div>
          <div class="ru-input">
            <svg class="ru-input__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5"/>
              <path d="M5 20c.6-3.6 3.4-5.5 7-5.5s6.4 1.9 7 5.5z"/>
            </svg>
            <input class="ru-input__control" type="text" id="operador_identificacao"
                   name="operador[identificacao]" placeholder="Ex: 1984201 ou operador.darcy"
                   autocomplete="username" autocapitalize="none" spellcheck="false"
                   aria-required="true">
          </div>
        </div>

        <div class="ru-field">
          <div class="ru-field__head">
            <label class="ru-field__label" for="operador_senha">Senha de Acesso</label>
            <span class="ru-field__hint">Obrigatório</span>
          </div>
          <div class="ru-input">
            <svg class="ru-input__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="11" width="14" height="9.5" rx="2"/>
              <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
              <path d="M12 15v2"/>
            </svg>
            <input class="ru-input__control ru-input__control--with-action" type="password" id="operador_senha"
                   name="operador[password]" placeholder="Digite sua senha de operador"
                   autocomplete="current-password" aria-required="true">
            <button class="ru-input__toggle" type="button" id="ru-toggle-senha"
                    aria-label="Mostrar senha" aria-controls="operador_senha" aria-pressed="false"
                    onclick="const campo = document.getElementById('operador_senha'), mostrar = campo.type === 'password';
                             campo.type = mostrar ? 'text' : 'password';
                             this.setAttribute('aria-pressed', mostrar);
                             this.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
                             this.querySelector('.ru-icon-show').toggleAttribute('hidden', mostrar);
                             this.querySelector('.ru-icon-hide').toggleAttribute('hidden', !mostrar);">
              <svg class="ru-icon-show" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="ru-icon-hide" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                <path d="M3 3l18 18"/>
                <path d="M10.6 5.6A10 10 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17 17 0 0 1-3.2 4M6.5 6.9C3.7 8.7 2 12 2 12s3.6 6.5 10 6.5c1.5 0 2.8-.3 4-.9"/>
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
              </svg>
            </button>
          </div>
        </div>

        <button class="ru-submit" type="submit">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/>
            <path d="M3 12h11M10 8l4 4-4 4"/>
          </svg>
          Entrar no Sistema
        </button>
      <% end %>                                                                               
    </section>
  </main>
</div>