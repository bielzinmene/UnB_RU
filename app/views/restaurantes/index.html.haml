.form-page
  .form-card.account-card
    %p.eyebrow ADMINISTRAÇÃO
    %h1 Restaurantes e Catracas
    %p.form-intro Gerencie os restaurantes universitários (IDs 1 a 6) e suas catracas físicas.

    %h2 Cadastrar Restaurante com Catraca
    = form_with url: restaurantes_path, method: :post do |f|
      .field
        = f.label :codigo, "ID do Restaurante (1 a 6)"
        = f.number_field :codigo, required: true
      .field
        = f.label :nome, "Nome do Restaurante"
        = f.text_field :nome, placeholder: "Ex: RU Central"
      .field
        = f.label :catraca_codigo, "ID da Catraca Inicial (1 a 6)"
        = f.number_field :catraca_codigo
      = f.submit "Cadastrar Restaurante", class: "button"

    %hr
    %h2 Restaurantes Cadastrados
    - @restaurantes.each do |restaurante|
      .card-item
        %strong= "#{restaurante.nome} (ID: #{restaurante.codigo})"
        %p Catracas associadas: #{restaurante.catracas.map(&:nome).join(", ").presence || "Nenhuma"}